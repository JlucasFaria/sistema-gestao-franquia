# Coleção de requisições da API de Gestão de Franquias.
#
# Uso: com a API rodando (dotnet run --project src/Franquias.Api), execute as requisições
# pelo Visual Studio 2022 ou pela extensão REST Client do VS Code. Rode primeiro os três
# logins: os tokens são reaproveitados nas demais requisições.
#
# Os identificadores fixos referem-se aos dados de exemplo carregados em um banco novo:
#   unidades: 1 Paulista, 2 Campinas, 3 Savassi, 4 Curitiba (implantação), 5 Niterói (inativa)
#   produtos: 1 Coxinha, 4 Suco, 9 Consultoria (serviço), 11 Esfiha (descontinuado)
#   usuários: 1 administrador, 2 gestor, 3 operador

@baseUrl = http://localhost:5270
@unidade = 1
@produto = 1
@fornecedor = 1
@chamado = 1
@royalty = 3

# Período usado na geração de royalty: precisa estar encerrado (fim antes de hoje) e ainda
# sem cobrança. Com os dados de exemplo, use do primeiro dia do mês corrente até ontem.
@competenciaInicio = 2026-09-01
@competenciaFim = 2026-09-15
@competenciaVencimento = 2026-10-10

###############################################################################
# Autenticação
###############################################################################

# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@franquias.com.br",
  "senha": "Admin@123"
}

###

# @name loginGestor
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "gestor@franquias.com.br",
  "senha": "Gestor@123"
}

###

# @name loginOperador
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "operador@franquias.com.br",
  "senha": "Operador@123"
}

###

@admin = {{loginAdmin.response.body.$.token}}
@gestor = {{loginGestor.response.body.$.token}}
@operador = {{loginOperador.response.body.$.token}}

# Credenciais inválidas: 401
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@franquias.com.br",
  "senha": "senha-errada"
}

###

# Sem token: 401
GET {{baseUrl}}/api/unidades

###

# Operador tentando uma ação de administrador: 403
POST {{baseUrl}}/api/categorias
Authorization: Bearer {{operador}}
Content-Type: application/json

{
  "nome": "Sobremesas"
}

###

# Registro de usuário já com login (somente administrador)
POST {{baseUrl}}/api/auth/registrar
Authorization: Bearer {{admin}}
Content-Type: application/json

{
  "nome": "Paula Ribeiro",
  "email": "paula.ribeiro@franquias.com.br",
  "senha": "Paula@2026",
  "perfilId": 3
}

