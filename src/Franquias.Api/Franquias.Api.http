Authorization: Bearer {{operador}}

###

GET {{baseUrl}}/api/vendas?status=Pendente
Authorization: Bearer {{operador}}

###

# @name novaVenda
POST {{baseUrl}}/api/vendas
Authorization: Bearer {{operador}}
Content-Type: application/json

{
  "unidadeFranqueadaId": {{unidade}},
  "itens": [
    { "produtoServicoId": 1, "quantidade": 2 },
    { "produtoServicoId": 4, "quantidade": 1 },
    { "produtoServicoId": 9, "quantidade": 1, "precoUnitario": 300.00 }
  ]
}

###

GET {{baseUrl}}/api/vendas/{{novaVenda.response.body.$.id}}
Authorization: Bearer {{operador}}

###

# Confirmar baixa o estoque dos produtos físicos
POST {{baseUrl}}/api/vendas/{{novaVenda.response.body.$.id}}/confirmar
Authorization: Bearer {{operador}}

###

# Cancelar estorna o estoque (somente gestão)
POST {{baseUrl}}/api/vendas/{{novaVenda.response.body.$.id}}/cancelar
Authorization: Bearer {{gestor}}

###

# Venda sem itens: 400
POST {{baseUrl}}/api/vendas
Authorization: Bearer {{operador}}
Content-Type: application/json

{
  "unidadeFranqueadaId": {{unidade}},
  "itens": []
}

###

# Unidade inativa não vende: 422
POST {{baseUrl}}/api/vendas
Authorization: Bearer {{operador}}
Content-Type: application/json

{
  "unidadeFranqueadaId": 5,
  "itens": [
    { "produtoServicoId": 1, "quantidade": 1 }
  ]
}

###############################################################################
# Royalties
###############################################################################

GET {{baseUrl}}/api/royalties?situacao=Atrasado
Authorization: Bearer {{gestor}}

###

GET {{baseUrl}}/api/royalties?unidadeFranqueadaId={{unidade}}
Authorization: Bearer {{gestor}}

###

# @name cobranca
GET {{baseUrl}}/api/royalties/{{royalty}}
Authorization: Bearer {{gestor}}

###

# @name novoRoyalty
POST {{baseUrl}}/api/royalties
Authorization: Bearer {{admin}}
Content-Type: application/json

{
  "unidadeFranqueadaId": {{unidade}},
  "periodoInicio": "{{competenciaInicio}}",
  "periodoFim": "{{competenciaFim}}",
  "dataVencimento": "{{competenciaVencimento}}"
}

###

# Baixa pelo valor devido lido na consulta acima
POST {{baseUrl}}/api/royalties/{{royalty}}/pagamento
Authorization: Bearer {{admin}}
Content-Type: application/json

{
  "dataPagamento": "{{competenciaFim}}",
  "valorPago": {{cobranca.response.body.$.valorDevido}}
}

###

# Cobrança já quitada: 422
POST {{baseUrl}}/api/royalties/{{royalty}}/pagamento
Authorization: Bearer {{admin}}
Content-Type: application/json

{
  "dataPagamento": "{{competenciaFim}}",
  "valorPago": {{cobranca.response.body.$.valorDevido}}
}

###

POST {{baseUrl}}/api/royalties/atualizar-atrasos
Authorization: Bearer {{admin}}

###

# Valores devidos e pagos de uma unidade e da rede
GET {{baseUrl}}/api/royalties/unidades/{{unidade}}/resumo
Authorization: Bearer {{gestor}}

###

GET {{baseUrl}}/api/royalties/resumo-por-unidade?competenciaInicio=2026-06-01
Authorization: Bearer {{gestor}}

###############################################################################
# Chamados de suporte
###############################################################################

GET {{baseUrl}}/api/chamados?unidadeFranqueadaId={{unidade}}
Authorization: Bearer {{operador}}

###

# Chamados em aberto, por prioridade ou unidade
GET {{baseUrl}}/api/chamados/em-aberto
Authorization: Bearer {{operador}}

###

GET {{baseUrl}}/api/chamados/em-aberto?prioridade=Alta
Authorization: Bearer {{operador}}

###

GET {{baseUrl}}/api/chamados/{{chamado}}
Authorization: Bearer {{operador}}

###

# @name novoChamado
POST {{baseUrl}}/api/chamados
Authorization: Bearer {{operador}}
Content-Type: application/json

{
  "unidadeFranqueadaId": {{unidade}},
  "categoria": "Sistema",
  "assunto": "Leitor de código de barras sem resposta",
  "descricao": "O leitor do caixa 1 parou de reconhecer os produtos.",
  "prioridade": "Alta"
}

###

POST {{baseUrl}}/api/chamados/{{novoChamado.response.body.$.id}}/interacoes
Authorization: Bearer {{operador}}
Content-Type: application/json

{
  "mensagem": "Trocamos o cabo USB e o problema continua."
}

###

PATCH {{baseUrl}}/api/chamados/{{novoChamado.response.body.$.id}}/prioridade
Authorization: Bearer {{gestor}}
Content-Type: application/json

{
  "prioridade": "Critica"
}

###

PATCH {{baseUrl}}/api/chamados/{{novoChamado.response.body.$.id}}/status
Authorization: Bearer {{gestor}}
Content-Type: application/json

{
  "status": "EmAtendimento",
  "observacao": "Equipamento reserva enviado."
}

###

PATCH {{baseUrl}}/api/chamados/{{novoChamado.response.body.$.id}}/status
Authorization: Bearer {{gestor}}
Content-Type: application/json

{
  "status": "Encerrado",
  "observacao": "Leitor substituído."
}

###

# Chamado encerrado não aceita mensagem: 422
POST {{baseUrl}}/api/chamados/{{novoChamado.response.body.$.id}}/interacoes
Authorization: Bearer {{operador}}
Content-Type: application/json

{
  "mensagem": "Mais uma mensagem."
}

